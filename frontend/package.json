{
  "name": "newscombo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:timeline": "node tests/timeline.regression.mjs",
    "test": "node --test tests/*.regression.mjs",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.regression.mjs",
    "test:pwa": "node tests/pwa-build.mjs"
  },
  "dependencies": {
    "@iconify-icons/lucide": "^2.0.36",
    "@iconify/vue": "^5.0.5",
    "@tailwindcss/vite": "^4.3.5",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.1",
    "dompurify": "^3.5.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.46",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "daisyui": "^5.8.3",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.4"
    }
  }
}
